//@version=6
strategy("EUR/USD — H4 Trend + H1 Pullback (v9)",
     overlay=true,
     initial_capital=50,
     commission_type=strategy.commission.percent,
     commission_value=0.02,
     slippage=1,
     pyramiding=0,
     process_orders_on_close=true,
     calc_on_order_fills=true)

// ============================================================================
// v9 — H4 Trend + H1 Pullback
// ============================================================================
// Correctifs principaux v9 :
// 1. Syntaxe request.security(...) [1] pour éviter tout sur-décalage H4.
// 2. Sizing Forex exact basé sur la distance d'invalidation (riskAmount / slDistance).
// 3. Gestion dynamique native du Breakeven via l'inspection de strategy.closedtrades.
// ============================================================================


// ============================================================================
// TIMEFRAME CHECK
// ============================================================================

if barstate.isfirst and timeframe.period != "15"
    runtime.error("Ce script doit tourner sur un graphique H1 (60).")


// ============================================================================
// PARAMÈTRES
// ============================================================================

emaFastLen = input.int(20, "EMA rapide")
emaSlowLen = input.int(50, "EMA lente")
riskReward = input.float(2.0, "Risk / Reward", minval=1.0, step=0.5)

swingLookback = input.int(5, "Swing lookback (SL)", minval=2)
atrLen        = input.int(14, "ATR période")
atrBuffer     = input.float(0.2, "Buffer SL (x ATR)", step=0.1)

riskPercent = input.float(1.0, "Risque par trade (%)", minval=0.1, step=0.1)

maxBarsConfirm = input.int(5, "Barres max entre pullback et confirmation", minval=1)
maxDistAtr     = input.float(1.5, "Distance max EMA20 à confirmation (x ATR)", minval=0.1)


// ============================================================================
// FILTRE ADX
// ============================================================================

adxLen       = input.int(14, "ADX / DMI période", group="Filtre ADX")
adxThreshold = input.float(20.0, "ADX minimum", group="Filtre ADX")


// ============================================================================
// FILTRE RSI
// ============================================================================

rsiLen      = input.int(14, "RSI période", group="Filtre RSI")

rsiLongMin  = input.float(40.0, "RSI min (long)", group="Filtre RSI")
rsiLongMax  = input.float(55.0, "RSI max (long)", group="Filtre RSI")

rsiShortMin = input.float(45.0, "RSI min (short)", group="Filtre RSI")
rsiShortMax = input.float(60.0, "RSI max (short)", group="Filtre RSI")


// ============================================================================
// SESSION
// ============================================================================

useSession    = input.bool(true, "Filtrer par session", group="Session")
sessionString = input.session("0700-1600", "Session de trading", group="Session")
sessionTZ     = input.string("UTC", "Fuseau horaire", group="Session")

sessionTime = time(timeframe.period, sessionString, sessionTZ)
inSession   = not na(sessionTime)

sessionOk = not useSession or inSession


// ============================================================================
// ENGULFING
// ============================================================================

breakoutLookback = input.int(
     3,
     "Bougies pour engulfing renforcé",
     minval=1,
     group="Engulfing"
)


// ============================================================================
// GESTION DE TRADE
// ============================================================================

usePartial = input.bool(
     true,
     "Activer sortie partielle + breakeven",
     group="Gestion de trade"
)

partialRMultiple = input.float(
     1.0,
     "R pour sortie partielle",
     minval=0.1,
     group="Gestion de trade"
)

partialPercent = input.float(
     50.0,
     "% sortie partielle",
     minval=1,
     maxval=99,
     group="Gestion de trade"
)


// ============================================================================
// BACKTEST
// ============================================================================

useDateFilter = input.bool(
     false,
     "Restreindre à une plage de dates",
     group="Backtest"
)

startDate = input.time(
     timestamp("2020-01-01 00:00"),
     "Début",
     group="Backtest"
)

endDate = input.time(
     timestamp("2025-01-01 00:00"),
     "Fin",
     group="Backtest"
)

dateOk = not useDateFilter or (time >= startDate and time <= endDate)


// ============================================================================
// TENDANCE H4 (Syntaxe v9 sans décalage excessif)
// ============================================================================

h4Close = request.security(
     syminfo.tickerid,
     "240",
     close
)[1]

h4EMA20 = request.security(
     syminfo.tickerid,
     "240",
     ta.ema(close, emaFastLen)
)[1]

h4EMA50 = request.security(
     syminfo.tickerid,
     "240",
     ta.ema(close, emaSlowLen)
)[1]

bullTrend =
     h4EMA20 > h4EMA50 and
     h4Close > h4EMA20

bearTrend =
     h4EMA20 < h4EMA50 and
     h4Close < h4EMA20


// ============================================================================
// INDICATEURS H1
// ============================================================================

ema20 = ta.ema(close, emaFastLen)
ema50 = ta.ema(close, emaSlowLen)

atr = ta.atr(atrLen)

[diPlus, diMinus, adxValue] = ta.dmi(adxLen, adxLen)

rsiValue = ta.rsi(close, rsiLen)


// ============================================================================
// FIN OOS
// ============================================================================

if useDateFilter and time > endDate and strategy.position_size != 0
    strategy.close_all(
         comment="Fin période OOS",
         alert_message='{"action":"close_all_oos_end"}'
    )


// ============================================================================
// ENGULFING
// ============================================================================

bullishEngulfingBase =
     close > open and
     close[1] < open[1] and
     close >= open[1] and
     open <= close[1]

bearishEngulfingBase =
     close < open and
     close[1] > open[1] and
     close <= open[1] and
     open >= close[1]

bullishBreakout =
     close > ta.highest(high[1], breakoutLookback)

bearishBreakout =
     close < ta.lowest(low[1], breakoutLookback)

bullishEngulfingStrong =
     bullishEngulfingBase and
     bullishBreakout

bearishEngulfingStrong =
     bearishEngulfingBase and
     bearishBreakout


// ============================================================================
// PULLBACK EMA20
// ============================================================================

pullbackLong =
     low <= ema20 and
     close > ema20

pullbackShort =
     high >= ema20 and
     close < ema20


// ============================================================================
// ÉTAT DU SETUP
// ============================================================================

var bool waitingLong = false
var bool waitingShort = false

var int pullbackBarLong = na
var int pullbackBarShort = na

if pullbackLong and bullTrend and not waitingLong
    waitingLong := true
    waitingShort := false
    pullbackBarLong := bar_index

if pullbackShort and bearTrend and not waitingShort
    waitingShort := true
    waitingLong := false
    pullbackBarShort := bar_index

if waitingLong and
     bar_index - pullbackBarLong > maxBarsConfirm

    waitingLong := false
    pullbackBarLong := na

if waitingShort and
     bar_index - pullbackBarShort > maxBarsConfirm

    waitingShort := false
    pullbackBarShort := na


// ============================================================================
// DISTANCE EMA20
// ============================================================================

closeEnoughLong =
     math.abs(close - ema20) <= maxDistAtr * atr

closeEnoughShort =
     math.abs(close - ema20) <= maxDistAtr * atr


// ============================================================================
// CONDITIONS D'ENTRÉE
// ============================================================================

longCondition =
     bullTrend and
     ema20 > ema50 and
     waitingLong and
     bullishEngulfingStrong and
     closeEnoughLong and
     adxValue > adxThreshold and
     rsiValue >= rsiLongMin and
     rsiValue <= rsiLongMax and
     sessionOk and
     dateOk and
     barstate.isconfirmed

shortCondition =
     bearTrend and
     ema20 < ema50 and
     waitingShort and
     bearishEngulfingStrong and
     closeEnoughShort and
     adxValue > adxThreshold and
     rsiValue >= rsiShortMin and
     rsiValue <= rsiShortMax and
     sessionOk and
     dateOk and
     barstate.isconfirmed


// ============================================================================
// SL STRUCTUREL
// ============================================================================

longSL =
     ta.lowest(low, swingLookback) -
     atr * atrBuffer

shortSL =
     ta.highest(high, swingLookback) +
     atr * atrBuffer


// ============================================================================
// ÉTAT DU TRADE & SUIVI DES ORDRES
// ============================================================================

var float longEntryPx = na
var float longSLPrice = na
var float longTP1Price = na
var float longTP2Price = na

var float shortEntryPx = na
var float shortSLPrice = na
var float shortTP1Price = na
var float shortTP2Price = na

var bool longPartialDone = false
var bool shortPartialDone = false


// Détection dynamique du TP1 via strategy.closedtrades
if strategy.position_size > 0 and usePartial and not longPartialDone
    if strategy.closedtrades > 0
        lastComment = strategy.closedtrades.exit_comment(strategy.closedtrades - 1)
        if str.contains(lastComment, "TP1")
            longPartialDone := true

if strategy.position_size < 0 and usePartial and not shortPartialDone
    if strategy.closedtrades > 0
        lastComment = strategy.closedtrades.exit_comment(strategy.closedtrades - 1)
        if str.contains(lastComment, "TP1")
            shortPartialDone := true


// ============================================================================
// ENTRÉE LONG
// ============================================================================

if longCondition and strategy.position_size == 0

    entryPrice = close
    slDistance = entryPrice - longSL

    if slDistance > 0

        // Sizing Forex Cash direct
        riskAmount = strategy.equity * (riskPercent / 100)
        qty = riskAmount / slDistance

        if not na(qty) and qty > 0

            takeProfit = entryPrice + slDistance * riskReward
            partialPrice = entryPrice + slDistance * partialRMultiple

            strategy.entry(
                 "BUY",
                 strategy.long,
                 qty=qty,
                 alert_message=
                     '{"action":"buy","ticker":"' + syminfo.ticker + '","entry":' + str.tostring(entryPrice) +
                     ',"sl":' + str.tostring(longSL) + ',"tp":' + str.tostring(takeProfit) + '}'
            )

            longEntryPx := entryPrice
            longSLPrice := longSL
            longTP1Price := partialPrice
            longTP2Price := takeProfit
            longPartialDone := false

    waitingLong := false
    pullbackBarLong := na


// ============================================================================
// ENTRÉE SHORT
// ============================================================================

if shortCondition and strategy.position_size == 0

    entryPrice = close
    slDistance = shortSL - entryPrice

    if slDistance > 0

        // Sizing Forex Cash direct
        riskAmount = strategy.equity * (riskPercent / 100)
        qty = riskAmount / slDistance

        if not na(qty) and qty > 0

            takeProfit = entryPrice - slDistance * riskReward
            partialPrice = entryPrice - slDistance * partialRMultiple

            strategy.entry(
                 "SELL",
                 strategy.short,
                 qty=qty,
                 alert_message=
                     '{"action":"sell","ticker":"' + syminfo.ticker + '","entry":' + str.tostring(entryPrice) +
                     ',"sl":' + str.tostring(shortSL) + ',"tp":' + str.tostring(takeProfit) + '}'
            )

            shortEntryPx := entryPrice
            shortSLPrice := shortSL
            shortTP1Price := partialPrice
            shortTP2Price := takeProfit
            shortPartialDone := false

    waitingShort := false
    pullbackBarShort := na


// ============================================================================
// GESTION DES SORTIES (EXIT ENGINE)
// ============================================================================

if strategy.position_size > 0
    activeSL = longPartialDone ? longEntryPx : longSLPrice

    if usePartial and not longPartialDone
        strategy.exit("BUY TP1", "BUY", limit=longTP1Price, stop=activeSL, qty_percent=partialPercent, comment="BUY TP1")
        strategy.exit("BUY TP2", "BUY", limit=longTP2Price, stop=activeSL, qty_percent=100 - partialPercent, comment="BUY TP2")
    else
        strategy.exit("BUY EXIT", "BUY", limit=longTP2Price, stop=activeSL, qty_percent=100, comment="BUY BE/TP2")

if strategy.position_size < 0
    activeSL = shortPartialDone ? shortEntryPx : shortSLPrice

    if usePartial and not shortPartialDone
        strategy.exit("SELL TP1", "SELL", limit=shortTP1Price, stop=activeSL, qty_percent=partialPercent, comment="SELL TP1")
        strategy.exit("SELL TP2", "SELL", limit=shortTP2Price, stop=activeSL, qty_percent=100 - partialPercent, comment="SELL TP2")
    else
        strategy.exit("SELL EXIT", "SELL", limit=shortTP2Price, stop=activeSL, qty_percent=100, comment="SELL BE/TP2")


// ============================================================================
// RESET DES ÉTATS
// ============================================================================

if strategy.position_size == 0 and strategy.position_size[1] != 0

    longEntryPx := na
    longSLPrice := na
    longTP1Price := na
    longTP2Price := na
    longPartialDone := false

    shortEntryPx := na
    shortSLPrice := na
    shortTP1Price := na
    shortTP2Price := na
    shortPartialDone := false


// ============================================================================
// AFFICHAGE
// ============================================================================

plot(
     ema20,
     "EMA 20",
     color=color.orange
)

plot(
     ema50,
     "EMA 50",
     color=color.blue
)

plotshape(
     longCondition,
     title="BUY",
     style=shape.labelup,
     location=location.belowbar,
     color=color.green,
     text="BUY",
     textcolor=color.white
)

plotshape(
     shortCondition,
     title="SELL",
     style=shape.labeldown,
     location=location.abovebar,
     color=color.red,
     text="SELL",
     textcolor=color.white
)

bgcolor(
     bullTrend
     ? color.new(color.green, 92)
     : bearTrend
     ? color.new(color.red, 92)
     : na
)

bgcolor(
     useSession and not inSession
     ? color.new(color.gray, 95)
     : na
)


// ============================================================================
// TABLEAU DE BORD
// ============================================================================

var table infoTable =
     table.new(
         position.top_right,
         2,
         8,
         bgcolor=color.new(color.black, 70),
         border_width=1
     )

if barstate.islast

    table.cell(
         infoTable,
         0,
         0,
         "Position",
         text_color=color.white
    )

    table.cell(
         infoTable,
         1,
         0,
         strategy.position_size != 0
         ? strategy.position_size > 0
             ? "LONG"
             : "SHORT"
         : "FLAT",
         text_color=color.white
    )

    table.cell(
         infoTable,
         0,
         1,
         "Équité",
         text_color=color.white
    )

    table.cell(
         infoTable,
         1,
         1,
         str.tostring(strategy.equity, "#.##"),
         text_color=color.white
    )

    table.cell(
         infoTable,
         0,
         2,
         "Risque/trade",
         text_color=color.white
    )

    table.cell(
         infoTable,
         1,
         2,
         str.tostring(riskPercent) + "%",
         text_color=color.white
    )

    table.cell(
         infoTable,
         0,
         3,
         "R:R",
         text_color=color.white
    )

    table.cell(
         infoTable,
         1,
         3,
         "1:" + str.tostring(riskReward),
         text_color=color.white
    )

    table.cell(
         infoTable,
         0,
         4,
         "ADX",
         text_color=color.white
    )

    table.cell(
         infoTable,
         1,
         4,
         str.tostring(adxValue, "#.#"),
         text_color=color.white
    )

    table.cell(
         infoTable,
         0,
         5,
         "RSI",
         text_color=color.white
    )

    table.cell(
         infoTable,
         1,
         5,
         str.tostring(rsiValue, "#.#"),
         text_color=color.white
    )

    table.cell(
         infoTable,
         0,
         6,
         "Setup",
         text_color=color.white
    )

    table.cell(
         infoTable,
         1,
         6,
         waitingLong
         ? "WAIT LONG"
         : waitingShort
             ? "WAIT SHORT"
             : "NONE",
         text_color=color.white
    )

    table.cell(
         infoTable,
         0,
         7,
         "TP1 Status",
         text_color=color.white
    )

    table.cell(
         infoTable,
         1,
         7,
         longPartialDone or shortPartialDone
         ? "DONE → BE"
         : "WAITING",
         text_color=color.white
    )

